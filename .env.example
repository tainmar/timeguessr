# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgres://postgres@localhost:5432/timeguessr
APP_URL=http://localhost:5173
PORT=8080
# "log" prints emails to stdout; "resend" sends them for real.
MAIL_DRIVER=log
RESEND_API_KEY=
MAIL_FROM="TimeGuessr <noreply@timeguessr.procrastination.land>"
# Optional: restrict who can create games (emails or @domain, comma separated). Empty = anyone.
ORGANIZER_EMAILS=
MAX_PARTICIPANTS_PER_GAME=200
MAX_EMAILS_PER_ORGANIZER_PER_DAY=400
